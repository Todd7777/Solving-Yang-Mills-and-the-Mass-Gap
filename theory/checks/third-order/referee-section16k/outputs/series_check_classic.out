# python3 series_check_classic.py
(a) exact series from the Bessel closed forms (to beta^10):
  SU(2): -log Upsilon = (1/8) beta^2 + (-1/192) beta^4 + (11/46080) beta^6 + (-17/1474560) beta^8 + (37/61931520) beta^10 + O(beta^12)
  U(1): -log U_+ = (3/8) beta^2 + (-13/384) beta^4 + (11/3072) beta^6 + (-329/737280) beta^8 + (109/1769472) beta^10 + O(beta^12)
  U(1): -log U_- = (1/8) beta^2 + (-5/384) beta^4 + (5/3072) beta^6 + (-161/737280) beta^8 + (271/8847360) beta^10 + O(beta^12)
  U(1): log(U_-/U_+) = (1/4) beta^2 + (-1/48) beta^4 + (1/512) beta^6 + (-7/30720) beta^8 + (137/4423680) beta^10 + O(beta^12)
  su2: odd coefficients all zero: True;  beta^2 = 1/8 (claimed 1/8): True;  beta^4 = -1/192 (claimed -1/192): True
  u1_plus: odd coefficients all zero: True;  beta^2 = 3/8 (claimed 3/8): True;  beta^4 = -13/384 (claimed -13/384): True
  u1_minus: odd coefficients all zero: True;  beta^2 = 1/8 (claimed 1/8): True;  beta^4 = -5/384 (claimed -5/384): True
  u1_log_ratio: odd coefficients all zero: True;  beta^2 = 1/4 (claimed 1/4): True;  beta^4 = -1/48 (claimed -1/48): True
  identical to rigorous_bounds.classic_series to beta^8: True

